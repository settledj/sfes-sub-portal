generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL (pooled, port 6543) is used at runtime for app queries.
// DIRECT_URL (unpooled, port 5432) is used only by `prisma migrate` — the
// transaction pooler doesn't support the session-level features migrations need.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// See Section 3 of the handoff doc for the original prototype data model.
// `availability` stays a JSON exception-map (dateKey -> "unavailable" | "booked")
// to match the prototype's "default available" model described there.
model Substitute {
  id             Int      @id @default(autoincrement())
  name           String
  initials       String
  phone          String
  email          String   @unique
  division       String[]
  subjects       String[]
  additionalInfo String   @default("")
  bio            String   @default("")
  hrApproved     Boolean  @default(false)
  needsApproval  Boolean  @default(false)
  preferred      Boolean  @default(false)
  accent         String   @default("#1B2A53")
  photo          String?
  availability   Json     @default("{}")
  // Notification preferences — "Booking updates" covers new requests, admin
  // bookings, accept/decline confirmations, and cancellations; "Messages"
  // covers the booking message thread. Split in two (not per-event-type) so
  // people can mute chatty conversations without missing booking changes.
  notifyBookingUpdates Boolean @default(true)
  notifyMessages       Boolean @default(true)
  requests       Request[]

  @@map("substitutes")
}

model Teacher {
  id       Int       @id @default(autoincrement())
  name     String
  subject  String
  room     String    @default("")
  email    String    @unique
  phone    String    @default("")
  initials String
  accent   String    @default("#1B2A53")
  photo    String?
  notifyBookingUpdates Boolean @default(true)
  notifyMessages       Boolean @default(true)
  requests Request[]

  @@map("teachers")
}

model Admin {
  id                    Int     @id @default(autoincrement())
  name                  String
  email                 String  @unique
  phone                 String  @default("")
  notifyBookingUpdates  Boolean @default(true)
  notifyMessages        Boolean @default(true)

  @@map("admins")
}

// One row per calendar day the school is closed (holidays, breaks) — reason
// is shown across every portal's calendar and blocks new teacher-initiated
// booking requests on that date. Admins can still override.
model SchoolClosure {
  id     String @id @default(cuid())
  dk     String @unique
  reason String

  @@map("school_closures")
}

enum RequestStatus {
  pending
  accepted
  declined
  cancelled
}

enum RequestSource {
  teacher
  admin
}

model Request {
  id          String        @id @default(cuid())
  subId       Int
  sub         Substitute    @relation(fields: [subId], references: [id])
  teacherId   Int
  teacher     Teacher       @relation(fields: [teacherId], references: [id])
  teacherName String
  dk          String
  subject     String        @default("")
  grade       String        @default("")
  notes       String        @default("")
  lessonPlan  String        @default("")
  schedule    String        @default("")
  attendance  String        @default("")
  // The substitute's own end-of-day account of how it went — student
  // behavior, what got covered, what didn't, anything the teacher should
  // know. Written by the substitute after the assignment; read-only for
  // everyone else. Single free-text field by design, matching the pattern
  // of the other booking notes fields rather than forcing rigid sub-sections.
  subFeedback String        @default("")
  status      RequestStatus @default(pending)
  source      RequestSource @default(teacher)
  // One-click accept/decline from the notification email, no login required.
  // Set when a request becomes pending, cleared the moment it's responded to
  // (by any path — the email link or the portal) so the link goes dead after
  // one use. See src/app/respond/[token]/page.tsx.
  respondToken String?      @unique
  // Set when a teacher or substitute asks to cancel an already-sent or
  // confirmed booking — cancellation isn't immediate for them, it needs an
  // admin to approve or deny it (see /request-cancel, /approve-cancel,
  // /deny-cancel). Admins cancel directly and never touch these fields.
  cancelRequestedAt DateTime?
  cancelRequestedBy AllowedRole?
  messages    Message[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("requests")
}

// Two-way thread scoped to a single booking — the "communicate back and
// forth" requirement. senderRole reuses AllowedRole so it always matches
// one of the three portal roles; senderName is denormalized (not a relation
// to Teacher/Substitute/Admin) since any of the three role tables could be
// the sender and messages should stay readable even if that person's roster
// row is later renamed or removed.
model Message {
  id         String      @id @default(cuid())
  requestId  String
  request    Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderRole AllowedRole
  senderName String
  body       String
  createdAt  DateTime    @default(now())

  @@map("messages")
}

// Real delivery, gated on RESEND_API_KEY / TWILIO_* env vars (see src/lib/notify.ts).
// This log is kept as an audit trail regardless — see Section 6 of the handoff doc.
// emailStatus/smsStatus: "sent" | "failed" | "skipped" (no key configured, or no
// recipient address/phone on file) — set by logNotification so a failed real send
// is visible in Admin > Notifications instead of looking identical to a successful one.
model Notification {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  event       String
  toName      String
  toEmail     String?
  toPhone     String?
  subject     String
  body        String
  emailStatus String   @default("skipped")
  emailError  String?
  smsStatus   String   @default("skipped")
  smsError    String?

  @@map("notifications")
}

enum AllowedRole {
  teacher
  substitute
  admin
}

// Access control list, independent of the Teacher/Substitute/Admin roster tables
// by design (an admin can grant portal access separately from roster membership).
// Checked in the Auth.js signIn callback in src/lib/auth.ts.
model AllowedUser {
  id           String      @id @default(cuid())
  email        String      @unique
  role         AllowedRole
  // Only set for people without a Google account (password-fallback sign-in).
  // Google-auth users have this null — see src/lib/auth.ts's Credentials provider.
  passwordHash String?
  // Self-service "forgot password" — set when a reset email is requested,
  // cleared the moment it's used (single-use) or replaced by a newer request.
  // See src/lib/passwordSetup.ts.
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt    DateTime    @default(now())

  @@map("allowed_users")
}

// --- Auth.js (next-auth v5) Prisma adapter schema ---
// @auth/prisma-adapter expects these exact model names (User/Account/Session/
// VerificationToken) — it doesn't support renaming them. Table names are still
// namespaced via @@map so they read clearly in the database itself. Session
// strategy is "jwt" (required for the Credentials/password provider to work
// alongside Google) — the adapter is still used so Google sign-ins get a
// linked User/Account record. These are Auth.js's own identity records, distinct
// from the app-level Teacher/Substitute/Admin rows they're matched to by email.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  @@map("auth_users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("auth_accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("auth_verification_tokens")
}
